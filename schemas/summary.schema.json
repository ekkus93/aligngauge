{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aligngauge.dev/schemas/summary-1.0.0.json",
  "title": "AlignGauge summary.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "application", "metric_definitions", "alignment_counters", "per_reference_counters", "coverage", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "application": {"type": "object"},
    "metric_definitions": {"type": "object"},
    "alignment_counters": {"$ref": "#/$defs/availability"},
    "per_reference_counters": {"$ref": "#/$defs/availability"},
    "coverage": {"oneOf": [
      {"$ref": "#/$defs/unavailable"},
      {"type": "object", "additionalProperties": false, "required": ["status", "value"], "properties": {
        "status": {"const": "available"},
        "value": {"$ref": "#/$defs/coverage"}
      }}
    ]},
    "warnings": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "availability": {"oneOf": [
      {"$ref": "#/$defs/unavailable"},
      {"type": "object", "required": ["status", "value"], "properties": {"status": {"const": "available"}, "value": true}}
    ]},
    "unavailable": {"type": "object", "additionalProperties": false, "required": ["status", "reason"], "properties": {"status": {"const": "unavailable"}, "reason": {"type": "string", "minLength": 1}}},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "total_accepted_aligned_bases", "depth_histogram", "threshold_bases", "threshold_percentages", "covered_reference_bases", "uncovered_reference_bases", "per_reference"],
      "properties": {
        "policy": {"type": "object"},
        "total_accepted_aligned_bases": {"type": "integer", "minimum": 0},
        "depth_histogram": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "threshold_bases": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "threshold_percentages": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$"}},
        "covered_reference_bases": {"type": "integer", "minimum": 0},
        "uncovered_reference_bases": {"type": "integer", "minimum": 0},
        "per_reference": {"type": "array", "items": {"$ref": "#/$defs/per_reference_coverage"}}
      }
    },
    "per_reference_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "length", "accepted_aligned_bases", "covered_reference_bases", "uncovered_reference_bases", "mean_depth"],
      "properties": {
        "name": {"type": "string"},
        "length": {"type": "integer", "minimum": 0},
        "accepted_aligned_bases": {"type": "integer", "minimum": 0},
        "covered_reference_bases": {"type": "integer", "minimum": 0},
        "uncovered_reference_bases": {"type": "integer", "minimum": 0},
        "mean_depth": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$"}
      }
    }
  }
}
