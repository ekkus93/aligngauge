{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aligngauge.dev/schemas/provenance-1.0.0.json",
  "title": "AlignGauge provenance.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application",
    "resolved_config",
    "input",
    "header_identity",
    "backend_versions",
    "analysis_plan",
    "resource_limits",
    "stage_timings_ns",
    "normalization_actions",
    "compatibility_profiles",
    "warnings",
    "errors",
    "system"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "application": { "type": "object" },
    "resolved_config": { "type": "object" },
    "input": { "type": "object" },
    "header_identity": { "type": "object" },
    "backend_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "analysis_plan": { "type": "object" },
    "resource_limits": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "stage_timings_ns": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "normalization_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "compatibility_profiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "warnings": { "type": "array" },
    "errors": { "type": "array" },
    "system": { "type": "object" }
  }
}
